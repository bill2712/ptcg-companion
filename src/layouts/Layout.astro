---
import '../styles/global.css';
import { langs, t, localePath, toContentLang, rtlLangs, langLabels } from '../locales/translations';
import { siteConfig, adsenseClient, isPreviewBuild } from '../site.config';

interface Props {
  title?: string;
  description?: string;
  keywords?: string;
  lang?: string;
  /** 'app' = full-screen counter with no page scroll; 'page' = normal scrolling article page. */
  mode?: 'app' | 'page';
  /** Path after the language prefix, e.g. 'privacy-policy/'. Used for hreflang links. */
  suffix?: string;
  /** Languages that have a version of this page. Defaults to all languages. */
  alternates?: readonly string[];
  noindex?: boolean;
  /** One schema.org object, or several that are output as an @graph. */
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
  ogType?: 'website' | 'article';
}

const {
  title = t('en', 'metaTitle'),
  description = t('en', 'metaDesc'),
  keywords,
  lang = 'en',
  mode = 'page',
  suffix,
  alternates = langs,
  noindex = false,
  jsonLd,
  ogType = 'website',
} = Astro.props;
const robotsNoindex = noindex || isPreviewBuild;
const ldJson = Array.isArray(jsonLd)
  ? { '@context': 'https://schema.org', '@graph': jsonLd.map(({ ['@context']: _, ...rest }) => rest) }
  : jsonLd;
const ogLocale = lang.replace('-', '_');

const siteUrl = siteConfig.siteUrl;
const abs = (path: string) => new URL(path, siteUrl).href;
const canonicalURL = abs(suffix !== undefined ? localePath(lang, suffix) : Astro.url.pathname);
const ogImage = abs('/og-image.png');
const cl = toContentLang(lang);
const dir = rtlLangs.includes(lang) ? 'rtl' : 'ltr';
// Ads load on content pages only, so Auto ads can never cover the game controls.
const loadAds = Boolean(adsenseClient) && (mode === 'page' || siteConfig.adsense.showOnCounter);
---

<!doctype html>
<html lang={lang} dir={dir}>
  <head>
    <meta charset="UTF-8" />
    <!-- Resolve the theme before first paint: saved choice, else the system setting. -->
    <script is:inline>
      (function () {
        var KEY = 'ptcg_theme', pref = null;
        try { pref = localStorage.getItem(KEY); } catch (e) {}
        var mq = window.matchMedia('(prefers-color-scheme: light)');
        function apply() {
          var theme = pref === 'light' || pref === 'dark' ? pref : (mq.matches ? 'light' : 'dark');
          document.documentElement.setAttribute('data-theme', theme);
          var meta = document.querySelector('meta[name="theme-color"]');
          if (meta) meta.setAttribute('content', theme === 'light' ? '#f3f3f6' : '#09090b');
        }
        apply();
        if (mq.addEventListener) mq.addEventListener('change', apply);
        window.__getThemePref = function () { return pref || 'system'; };
        window.__setTheme = function (v) {
          pref = v === 'system' ? null : v;
          try { pref ? localStorage.setItem(KEY, pref) : localStorage.removeItem(KEY); } catch (e) {}
          apply();
        };
        window.__cycleTheme = function () {
          window.__setTheme(document.documentElement.getAttribute('data-theme') === 'dark' ? 'light' : 'dark');
        };
        document.addEventListener('DOMContentLoaded', apply);
      })();
    </script>
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {keywords && <meta name="keywords" content={keywords} />}
    {robotsNoindex && <meta name="robots" content="noindex" />}
    <meta name="theme-color" content="#09090b" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/icon-192.png" />
    <link rel="manifest" href="/manifest.json" />

    <link rel="canonical" href={canonicalURL} />
    {suffix !== undefined && alternates.length > 1 && (
      <>
        {alternates.map((l) => <link rel="alternate" hreflang={l} href={abs(localePath(l, suffix))} />)}
        <link rel="alternate" hreflang="x-default" href={abs(localePath(alternates.includes('en') ? 'en' : alternates[0], suffix))} />
      </>
    )}

    <meta property="og:type" content={ogType} />
    <meta property="og:locale" content={ogLocale} />
    <meta property="og:site_name" content={siteConfig.name} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    {ldJson && <script is:inline type="application/ld+json" set:html={JSON.stringify(ldJson)} />}

    {adsenseClient && <meta name="google-adsense-account" content={adsenseClient} />}

    <!-- Consent Mode v2: ad and analytics storage stay off in the EEA, UK and
         Switzerland until the visitor accepts in Google's consent message
         (shown by the AdSense tag once Privacy & messaging is set up). -->
    <script is:inline define:vars={{ gaId: siteConfig.gaId }}>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('consent', 'default', {
        ad_storage: 'denied', ad_user_data: 'denied', ad_personalization: 'denied', analytics_storage: 'denied',
        region: ['AT','BE','BG','HR','CY','CZ','DK','EE','FI','FR','DE','GR','HU','IS','IE','IT','LV','LI','LT','LU','MT','NL','NO','PL','PT','RO','SK','SI','ES','SE','GB','CH'],
        wait_for_update: 500,
      });
      gtag('consent', 'default', { ad_storage: 'granted', ad_user_data: 'granted', ad_personalization: 'granted', analytics_storage: 'granted' });
      gtag('js', new Date());
      gtag('config', gaId);

      // Offline support. /sw.js also replaces the old coffee-timer worker at the same URL.
      if ('serviceWorker' in navigator && location.hostname !== 'localhost') {
        window.addEventListener('load', function () {
          navigator.serviceWorker.register('/sw.js').then(function () {
            return navigator.serviceWorker.ready;
          }).then(function (reg) {
            // Cache what this page already loaded, so it works offline from the first visit.
            var urls = performance.getEntriesByType('resource').map(function (e) { return e.name; })
              .filter(function (u) { return u.indexOf(location.origin) === 0; });
            urls.push(location.href);
            if (reg.active) reg.active.postMessage({ type: 'cache', urls: urls });
          }).catch(function () {});
        });
      }
    </script>
    <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${siteConfig.gaId}`}></script>
    {loadAds && (
      <script is:inline async src={`https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=${adsenseClient}`} crossorigin="anonymous"></script>
    )}
  </head>
  <body class={mode === 'app' ? 'app-shell bg-bg text-fg' : 'bg-bg text-fg min-h-screen flex flex-col'}>
    <a href="#main" class="sr-only focus:not-sr-only focus:fixed focus:top-2 focus:left-2 focus:z-[200] focus:bg-surface focus:text-fg focus:px-3 focus:py-2 focus:rounded-lg">Skip to content</a>

    {mode === 'page' && (
      <header class="sticky top-0 z-50 border-b border-line bg-bg/80 backdrop-blur-xl">
        <nav class="max-w-5xl mx-auto px-4 h-16 flex items-center gap-3 text-sm" aria-label="Main">
          <a href={localePath(lang)} class="flex items-center gap-2.5 font-semibold tracking-tight text-fg shrink-0">
            <img src="/favicon.svg" alt="" width="30" height="30" class="rounded-lg" />
            <span class="hidden sm:inline">PTCG Companion</span>
          </a>
          <div class="flex items-center gap-0.5 sm:gap-1 ml-auto overflow-x-auto hide-scrollbar">
            <a href={localePath(cl, 'guides/')} class="px-3 py-2 rounded-full text-muted hover:text-fg hover:bg-surface-2 transition-colors">{t(lang, 'navGuides')}</a>
            <a href={localePath(cl, 'tools/')} class="px-3 py-2 rounded-full text-muted hover:text-fg hover:bg-surface-2 transition-colors">{t(lang, 'navTools')}</a>
            <a href={localePath(cl, 'about/')} class="hidden sm:inline-flex px-3 py-2 rounded-full text-muted hover:text-fg hover:bg-surface-2 transition-colors">{t(lang, 'navAbout')}</a>
            <a href={localePath(cl, 'support/')} class="hidden sm:inline-flex px-3 py-2 rounded-full text-muted hover:text-fg hover:bg-surface-2 transition-colors whitespace-nowrap">{t(lang, 'navSupport')}</a>
            <button type="button" onclick="window.__cycleTheme && window.__cycleTheme()" class="w-9 h-9 rounded-full text-muted hover:text-fg hover:bg-surface-2 flex items-center justify-center shrink-0" aria-label="Theme" title="Theme">
              <svg class="hidden dark:block" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
              <svg class="block dark:hidden" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"/></svg>
            </button>
            <a href={localePath(lang)} class="ml-1 px-4 py-2 rounded-full bg-accent text-accent-fg font-medium hover:opacity-90 transition-opacity whitespace-nowrap">{t(lang, 'navCounter')}</a>
          </div>
        </nav>
      </header>
    )}

    <div id="main" class={mode === 'app' ? 'flex-1 w-full flex flex-col min-h-0 overflow-hidden relative' : 'flex-1 w-full'}>
      <slot />
    </div>

    <footer class={mode === 'app'
      ? 'text-faint text-[10px] py-1 w-full px-2 shrink-0'
      : 'text-muted text-sm py-12 border-t border-line w-full px-4 mt-16'}>
      <div class={mode === 'app' ? 'flex justify-center' : 'max-w-5xl mx-auto flex flex-col items-center gap-4'}>
        <nav class={mode === 'app' ? 'flex justify-center gap-x-3 whitespace-nowrap overflow-x-auto hide-scrollbar max-w-full' : 'flex flex-wrap justify-center gap-x-6 gap-y-2'} aria-label="Footer">
          <a href={localePath(cl, 'guides/')} class="hover:text-fg transition-colors">{t(lang, 'navGuides')}</a>
          <a href={localePath(cl, 'tools/')} class="hover:text-fg transition-colors">{t(lang, 'navTools')}</a>
          <a href={localePath(cl, 'about/')} class="hover:text-fg transition-colors">{t(lang, 'navAbout')}</a>
          <a href={localePath(cl, 'support/')} class="hover:text-fg transition-colors">{t(lang, 'navSupport')}</a>
          <a href={localePath(lang, 'privacy-policy/')} class="hover:text-fg transition-colors">{t(lang, 'privacyPolicy')}</a>
          <a href={localePath(lang, 'terms-of-service/')} class="hover:text-fg transition-colors">{t(lang, 'termsOfService')}</a>
          <a href={localePath(lang, 'contact/')} class="hover:text-fg transition-colors">{t(lang, 'contactSupport')}</a>
        </nav>
        {mode === 'page' && (
          <>
            <nav class="flex flex-wrap justify-center gap-x-4 gap-y-1 text-xs text-faint" aria-label="Language">
              {langs.map((l) => <a href={localePath(l)} hreflang={l} class="hover:text-fg transition-colors">{langLabels[l]}</a>)}
            </nav>
            <p class="text-xs text-faint text-center max-w-2xl leading-relaxed">{t(lang, 'disclaimer')}</p>
            <p class="text-xs text-faint">© {new Date().getFullYear()} PTCG Companion</p>
          </>
        )}
      </div>
    </footer>
  </body>
</html>
