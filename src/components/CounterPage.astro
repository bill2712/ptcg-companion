---
import Layout from '../layouts/Layout.astro';
import PTCGCounter from './PTCGCounter';
import { t, localePath } from '../locales/translations';
import { siteConfig, adsenseClient, donationLinks } from '../site.config';

interface Props { lang: string }
const { lang } = Astro.props;
const title = t(lang, 'metaTitle');
const description = t(lang, 'metaDesc');
const ad = siteConfig.adsense.showOnCounter && adsenseClient && siteConfig.adsense.slots.counter
  ? { client: adsenseClient, slot: siteConfig.adsense.slots.counter }
  : null;
const home = new URL('/', siteConfig.siteUrl).href;
const jsonLd = [
  {
    '@type': 'WebSite',
    '@id': `${home}#website`,
    name: siteConfig.name,
    url: home,
    inLanguage: lang,
  },
  {
    '@type': 'WebApplication',
    name: siteConfig.name,
    url: new URL(localePath(lang), siteConfig.siteUrl).href,
    description,
    applicationCategory: 'GameApplication',
    operatingSystem: 'Any (web browser)',
    browserRequirements: 'Requires JavaScript',
    inLanguage: lang,
    isAccessibleForFree: true,
    isPartOf: { '@id': `${home}#website` },
    image: new URL('/og-image.png', siteConfig.siteUrl).href,
    offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
  },
];
---

<Layout title={title} description={description} keywords={t(lang, 'metaKeywords')} lang={lang} mode="app" suffix="" jsonLd={jsonLd}>
  <h1 class="sr-only">{title}</h1>
  <main class="w-full flex-1 min-h-0 flex flex-col bg-bg">
    <PTCGCounter lang={lang} ad={ad} supportUrl={donationLinks[0]?.url ?? ''} client:load />
  </main>
</Layout>
