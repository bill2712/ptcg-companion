---
// A quiet donation prompt for the end of content pages.
import { t, localePath, toContentLang } from '../locales/translations';
import { donationLinks } from '../site.config';

interface Props { lang: string }
const { lang } = Astro.props;
const primary = donationLinks[0];
---

<aside class="mt-12 p-6 rounded-2xl bg-gradient-to-br from-pink-950/50 to-neutral-900 border border-pink-900/60 text-center">
  <p class="text-lg font-bold text-white mb-1">♥ {t(lang, 'supportCta')}</p>
  <p class="text-sm text-neutral-300 mb-4">{t(lang, 'supportCtaDesc')}</p>
  {primary ? (
    <a href={primary.url} target="_blank" rel="noopener" class="inline-block px-5 py-2.5 rounded-xl bg-pink-600 hover:bg-pink-500 font-bold text-white">{t(lang, 'supportBtn')} ({primary.label})</a>
  ) : (
    <a href={localePath(toContentLang(lang), 'support/')} class="inline-block px-5 py-2.5 rounded-xl bg-pink-600 hover:bg-pink-500 font-bold text-white">{t(lang, 'supportBtn')}</a>
  )}
</aside>
