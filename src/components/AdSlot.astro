---
// Responsive AdSense unit. Renders nothing until a publisher ID and slot ID
// are set in site.config.ts; in `npm run dev` it shows a dashed placeholder.
import { siteConfig, adsenseClient } from '../site.config';
import { t } from '../locales/translations';

interface Props {
  lang: string;
  slot?: string;
}
const { lang, slot = siteConfig.adsense.slots.content } = Astro.props;
const live = Boolean(adsenseClient && slot);
const preview = !live && import.meta.env.DEV;
---

{live && (
  <aside class="my-12" aria-label={t(lang, 'adLabel')}>
    <p class="text-[11px] text-faint mb-2 text-center">{t(lang, 'adLabel')}</p>
    <ins class="adsbygoogle block" style="display:block" data-ad-client={adsenseClient} data-ad-slot={slot} data-ad-format="auto" data-full-width-responsive="true"></ins>
    <script is:inline>(window.adsbygoogle = window.adsbygoogle || []).push({});</script>
  </aside>
)}
{preview && (
  <div class="my-12 h-24 border border-dashed border-line-strong rounded-2xl flex items-center justify-center text-xs text-faint">
    Ad slot (set adsense.publisherId and slots.content in src/site.config.ts)
  </div>
)}
