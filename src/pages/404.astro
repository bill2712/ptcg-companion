---
import Layout from '../layouts/Layout.astro';
---

<Layout title="404 - Page not found | PTCG Companion" noindex>
  <main class="flex flex-col items-center justify-center text-center px-4 py-24">
    <h1 class="text-8xl font-black text-red-600 mb-4 tracking-tighter" style="text-shadow: 0 0 30px rgba(220,38,38,0.6)">404</h1>
    <h2 class="text-2xl font-bold text-neutral-300 mb-4 uppercase tracking-widest">Page not found / 找不到頁面</h2>
    <p class="text-neutral-500 mb-10 max-w-md">The page you are looking for does not exist. It may have moved, or the link was mistyped.</p>
    <div class="flex flex-col sm:flex-row gap-3">
      <a href="/" class="bg-indigo-600 text-white font-bold py-3 px-6 rounded-xl hover:bg-indigo-500">Match counter</a>
      <a href="/en/guides/" class="bg-neutral-800 text-white font-bold py-3 px-6 rounded-xl hover:bg-neutral-700">Guides</a>
      <a href="/zh-TW/" class="bg-neutral-800 text-white font-bold py-3 px-6 rounded-xl hover:bg-neutral-700">返回對戰桌</a>
    </div>
  </main>
</Layout>
