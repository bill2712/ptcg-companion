---
import Layout from '../layouts/Layout.astro';
---

<Layout title="404 - Page not found | PTCG Companion" noindex>
  <main class="flex flex-col items-center justify-center text-center px-4 py-24 sm:py-32">
    <p class="text-sm font-semibold text-accent mb-3">404</p>
    <h1 class="text-4xl sm:text-5xl font-bold tracking-tight text-fg mb-4">Page not found</h1>
    <p class="text-muted mb-2">找不到頁面</p>
    <p class="text-muted mb-10 max-w-md">The page you are looking for does not exist. It may have moved, or the link was mistyped.</p>
    <div class="flex flex-col sm:flex-row gap-3">
      <a href="/" class="inline-flex items-center justify-center h-12 px-6 rounded-full bg-accent text-accent-fg font-semibold">Match counter</a>
      <a href="/en/guides/" class="inline-flex items-center justify-center h-12 px-6 rounded-full bg-surface border border-line text-fg font-medium">Guides</a>
      <a href="/zh-TW/" class="inline-flex items-center justify-center h-12 px-6 rounded-full bg-surface border border-line text-fg font-medium">返回對戰桌</a>
    </div>
  </main>
</Layout>
