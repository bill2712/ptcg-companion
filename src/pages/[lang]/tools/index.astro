---
import Layout from '../../../layouts/Layout.astro';
import AdSlot from '../../../components/AdSlot.astro';
import SupportCard from '../../../components/SupportCard.astro';
import TcgCard from '../../../components/TcgCard.astro';
import HeroCards from '../../../components/HeroCards.astro';
import { toolType } from '../../../utils/guides';
import { contentLangs, localePath, t, type ContentLang } from '../../../locales/translations';
import { toolsContent, toolSlugs } from '../../../locales/toolsContent';
import { absUrl, breadcrumbLd } from '../../../utils/seo';

export function getStaticPaths() {
  return contentLangs.map((lang) => ({ params: { lang } }));
}
const lang = Astro.params.lang as ContentLang;
const c = toolsContent[lang];
const jsonLd = [
  {
    '@type': 'ItemList',
    name: c.toolsTitle,
    itemListElement: toolSlugs.map((s, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      name: c.tools[s].title,
      url: absUrl(localePath(lang, `tools/${s}/`)),
    })),
  },
  breadcrumbLd([
    [c.home, localePath(lang)],
    [c.toolsTitle, localePath(lang, 'tools/')],
  ]),
];
---

<Layout title={`${c.toolsSeoTitle} | PTCG Companion`} description={c.toolsIntro} lang={lang} suffix="tools/" alternates={contentLangs} jsonLd={jsonLd}>
  <main class="max-w-5xl mx-auto px-4">
    <section class="relative mt-6 sm:mt-10 mb-10 sm:mb-14 rounded-[32px] border border-line bg-surface overflow-hidden">
      <div class="absolute inset-0 hero-glow pointer-events-none" aria-hidden="true"></div>
      <div class="ball-pattern relative grid md:grid-cols-[1.2fr_1fr] items-center gap-6 px-6 py-10 sm:px-12 sm:py-14">
        <div class="text-center md:text-left">
          <p class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-accent-soft text-accent text-xs font-semibold mb-5">{c.toolsEyebrow}</p>
          <h1 class="text-4xl sm:text-5xl font-bold text-fg mb-4 leading-[1.1]">{c.toolsTitle}</h1>
          <p class="text-muted text-lg max-w-xl mx-auto md:mx-0 leading-relaxed">{c.toolsIntro}</p>
        </div>
        <HeroCards types={['Lightning', 'Psychic', 'Water']} />
      </div>
    </section>

    <ul class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
      <li>
        <TcgCard href={localePath(lang)} type="Grass" title={t(lang, 'navCounter')} desc={t(lang, 'metaDesc')} label={c.toolsEyebrow} cta={t(lang, 'openCounter')} />
      </li>
      {toolSlugs.map((s) => {
        const tc = c.tools[s];
        return (
          <li>
            <TcgCard href={localePath(lang, `tools/${s}/`)} type={toolType(s)} title={tc.title} desc={tc.card} label={c.toolsEyebrow} cta={c.openTool} />
          </li>
        );
      })}
    </ul>
    <AdSlot lang={lang} />
    <SupportCard lang={lang} />
  </main>
</Layout>
