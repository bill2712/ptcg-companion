---
import Layout from '../../layouts/Layout.astro';
import { contentLangs, type ContentLang } from '../../locales/translations';
import { pageContent } from '../../locales/pageContent';
import { siteConfig, donationLinks } from '../../site.config';

export function getStaticPaths() {
  return contentLangs.map((lang) => ({ params: { lang } }));
}
const lang = Astro.params.lang as ContentLang;
const c = pageContent[lang];
const styles: Record<string, string> = {
  kofi: 'bg-[#13C3FF] text-neutral-950 hover:brightness-110',
  bmc: 'bg-[#FFDD00] text-neutral-950 hover:brightness-110',
  paypal: 'bg-[#0070BA] text-white hover:brightness-110',
};
---

<Layout title={`${c.supportTitle}`} description={c.supportIntro} lang={lang} suffix="support/" alternates={contentLangs}>
  <main class="max-w-2xl mx-auto px-4 py-10">
    <div class="text-center">
      <div class="text-5xl mb-4" aria-hidden="true">♥</div>
      <h1 class="text-3xl sm:text-4xl font-black text-white mb-4">{c.supportTitle}</h1>
      <p class="text-neutral-300 leading-relaxed">{c.supportIntro}</p>
    </div>

    <section class="mt-8 p-6 rounded-2xl bg-neutral-900 border border-neutral-800 text-center">
      <h2 class="text-lg font-bold text-white mb-4">{c.supportButtons}</h2>
      {donationLinks.length > 0 ? (
        <div class="flex flex-col sm:flex-row justify-center gap-3">
          {donationLinks.map((d) => (
            <a href={d.url} target="_blank" rel="noopener" class={`px-6 py-3 rounded-xl font-black ${styles[d.id]}`}>{d.label}</a>
          ))}
        </div>
      ) : (
        <p class="text-neutral-400">{c.supportNone} <a href={`mailto:${siteConfig.contactEmail}`} class="text-indigo-300 hover:underline">{siteConfig.contactEmail}</a></p>
      )}
    </section>

    <section class="mt-10">
      <h2 class="text-xl font-bold text-white mb-3">{c.supportWhatTitle}</h2>
      <ul class="space-y-2 text-neutral-300">
        {c.supportWhat.map((w) => <li class="flex gap-2"><span class="text-pink-400" aria-hidden="true">•</span>{w}</li>)}
      </ul>
    </section>

    <section class="mt-10">
      <h2 class="text-xl font-bold text-white mb-3">{c.supportOtherTitle}</h2>
      <ul class="space-y-2 text-neutral-300">
        {c.supportOther.map((w) => <li class="flex gap-2"><span class="text-indigo-400" aria-hidden="true">•</span>{w}</li>)}
      </ul>
      <p class="mt-4 text-sm text-neutral-400"><a href={`mailto:${siteConfig.contactEmail}`} class="text-indigo-300 hover:underline">{siteConfig.contactEmail}</a></p>
    </section>

    <p class="mt-12 text-center text-neutral-400">{c.supportThanks}</p>
  </main>
</Layout>
