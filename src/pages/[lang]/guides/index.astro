---
import { getCollection } from 'astro:content';
import Layout from '../../../layouts/Layout.astro';
import AdSlot from '../../../components/AdSlot.astro';
import SupportCard from '../../../components/SupportCard.astro';
import TcgCard from '../../../components/TcgCard.astro';
import HeroCards from '../../../components/HeroCards.astro';
import { contentLangs, localePath, t, type ContentLang } from '../../../locales/translations';
import { pageContent } from '../../../locales/pageContent';
import { guideCategories, guideLang, guideSlug, guideType, readingMinutes } from '../../../utils/guides';

export function getStaticPaths() {
  return contentLangs.map((lang) => ({ params: { lang } }));
}
const lang = Astro.params.lang as ContentLang;
const c = pageContent[lang];
const guides = (await getCollection('guides'))
  .filter((g) => guideLang(g) === lang)
  .sort((a, b) => a.data.order - b.data.order);
const sections = guideCategories
  .map((cat) => ({ cat, ...c.categories[cat], items: guides.filter((g) => g.data.category === cat) }))
  .filter((s) => s.items.length > 0);
---

<Layout title={`${c.guidesTitle} - PTCG Companion`} description={c.guidesIntro} lang={lang} suffix="guides/" alternates={contentLangs}>
  <main class="max-w-5xl mx-auto px-4">
    <section class="relative mt-6 sm:mt-10 mb-10 sm:mb-14 rounded-[32px] border border-line bg-surface overflow-hidden">
      <div class="absolute inset-0 hero-glow pointer-events-none" aria-hidden="true"></div>
      <div class="ball-pattern relative grid md:grid-cols-[1.2fr_1fr] items-center gap-6 px-6 py-10 sm:px-12 sm:py-14">
        <div class="text-center md:text-left">
          <p class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-accent-soft text-accent text-xs font-semibold mb-5">{c.guidesEyebrow}</p>
          <h1 class="text-4xl sm:text-5xl font-bold text-fg mb-4 leading-[1.1]">{c.guidesTitle}</h1>
          <p class="text-muted text-lg max-w-xl mx-auto md:mx-0 leading-relaxed mb-8">{c.guidesIntro}</p>
          <a href={localePath(lang)} class="inline-flex items-center gap-2 h-12 px-6 rounded-full bg-accent text-accent-fg font-semibold shadow-[0_10px_24px_-10px_var(--accent)] hover:-translate-y-0.5 transition-transform">
            {t(lang, 'openCounter')}
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
          </a>
        </div>
        <HeroCards types={['Water', 'Fire', 'Grass']} />
      </div>
    </section>

    <nav class="flex flex-wrap gap-2 mb-10" aria-label={c.guidesTitle}>
      {sections.map((sec) => (
        <a href={`#${sec.cat}`} class="inline-flex items-center h-9 px-4 rounded-full bg-surface border border-line text-sm font-medium text-fg hover:border-line-strong transition-colors">
          {sec.title} <span class="ml-1.5 text-faint">{sec.items.length}</span>
        </a>
      ))}
    </nav>

    {sections.map((sec, i) => (
      <section id={sec.cat} class="mb-14 scroll-mt-24">
        <h2 class="text-2xl sm:text-3xl font-bold text-fg mb-2">{sec.title}</h2>
        <p class="text-muted mb-6 max-w-2xl leading-relaxed">{sec.intro}</p>
        <ul class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
          {sec.items.map((g) => {
            const slug = guideSlug(g);
            return (
              <li>
                <TcgCard
                  href={localePath(lang, `guides/${slug}/`)}
                  type={guideType(slug)}
                  title={g.data.title}
                  desc={g.data.description}
                  label={sec.title}
                  meta={`${readingMinutes(g.body)} ${c.minRead}`}
                  cta={c.readGuide}
                />
              </li>
            );
          })}
        </ul>
        {i === 1 && <AdSlot lang={lang} />}
      </section>
    ))}
    <AdSlot lang={lang} />
    <SupportCard lang={lang} />
  </main>
</Layout>
