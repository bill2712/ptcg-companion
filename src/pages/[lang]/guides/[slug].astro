---
import { getCollection, render } from 'astro:content';
import Layout from '../../../layouts/Layout.astro';
import AdSlot from '../../../components/AdSlot.astro';
import SupportCard from '../../../components/SupportCard.astro';
import { localePath, t } from '../../../locales/translations';
import { pageContent } from '../../../locales/pageContent';
import { siteConfig } from '../../../site.config';
import { guideLang, guideSlug } from '../../../utils/guides';

export async function getStaticPaths() {
  const all = await getCollection('guides');
  return all.map((entry) => {
    const lang = guideLang(entry);
    const slug = guideSlug(entry);
    const translations = all.filter((g) => guideSlug(g) === slug).map(guideLang);
    const related = all
      .filter((g) => guideLang(g) === lang && g.id !== entry.id)
      .sort((a, b) => a.data.order - b.data.order);
    return { params: { lang, slug }, props: { entry, translations, related } };
  });
}

const { entry, translations, related } = Astro.props;
const { lang, slug } = Astro.params as { lang: 'en' | 'zh-TW'; slug: string };
const c = pageContent[lang];
const { Content } = await render(entry);
const url = new URL(localePath(lang, `guides/${slug}/`), siteConfig.siteUrl).href;
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: entry.data.title,
  description: entry.data.description,
  dateModified: entry.data.updated.toISOString(),
  inLanguage: lang,
  mainEntityOfPage: url,
  author: { '@type': 'Organization', name: siteConfig.name },
  publisher: { '@type': 'Organization', name: siteConfig.name },
};
const dateStr = entry.data.updated.toLocaleDateString(lang, { year: 'numeric', month: 'long', day: 'numeric' });
---

<Layout title={`${entry.data.title} - PTCG Companion`} description={entry.data.description} lang={lang} suffix={`guides/${slug}/`} alternates={translations} jsonLd={jsonLd}>
  <main class="max-w-3xl mx-auto px-4 py-10">
    <nav class="text-sm text-neutral-500 mb-6" aria-label="Breadcrumb">
      <a href={localePath(lang, 'guides/')} class="hover:text-neutral-300">← {c.allGuides}</a>
    </nav>
    <article>
      <h1 class="text-3xl sm:text-4xl font-black text-white leading-tight mb-3">{entry.data.title}</h1>
      <p class="text-xs text-neutral-500 mb-8">{c.updated}: <time datetime={entry.data.updated.toISOString()}>{dateStr}</time></p>
      <div class="prose prose-invert prose-neutral max-w-none prose-headings:scroll-mt-20 prose-a:text-indigo-300 prose-table:text-sm prose-th:text-left">
        <Content />
      </div>
    </article>

    <div class="my-10 p-5 rounded-2xl bg-indigo-950/40 border border-indigo-900 flex flex-col sm:flex-row sm:items-center gap-4">
      <p class="text-indigo-100 flex-1">{t(lang, 'metaDesc')}</p>
      <a href={localePath(lang)} class="shrink-0 text-center px-4 py-2.5 rounded-xl bg-indigo-600 font-bold text-white hover:bg-indigo-500">{t(lang, 'openCounter')}</a>
    </div>

    <AdSlot lang={lang} />

    <section class="mt-10">
      <h2 class="text-xl font-bold text-white mb-4">{c.moreGuides}</h2>
      <ul class="space-y-2">
        {related.map((g) => (
          <li><a href={localePath(lang, `guides/${guideSlug(g)}/`)} class="text-indigo-300 hover:underline">{g.data.title}</a></li>
        ))}
      </ul>
    </section>

    <SupportCard lang={lang} />
  </main>
</Layout>
