---
import LegalPage from '../../components/LegalPage.astro';
import { langs } from '../../locales/translations';
import { getLegalPages } from '../../locales/legalPages';

export function getStaticPaths() {
  return langs.map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as string;
---

<LegalPage lang={lang} suffix="terms-of-service/" doc={getLegalPages(lang).terms} />
