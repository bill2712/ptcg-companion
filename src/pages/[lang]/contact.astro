---
import Layout from '../../layouts/Layout.astro';
import { langs, t } from '../../locales/translations';
import { siteConfig } from '../../site.config';

export function getStaticPaths() {
  return langs.map(lang => ({ params: { lang } }));
}

const { lang } = Astro.params;
const title = `${t(lang as string, 'contactTitle')} - PTCG Companion`;
---

<Layout title={title} lang={lang} suffix="contact/">
  <main class="text-muted py-12 sm:py-16 px-4">
    <div class="max-w-2xl mx-auto">
      <h1 class="text-3xl sm:text-4xl font-bold tracking-tight text-fg mb-8">{t(lang as string, 'contactTitle')}</h1>
      
      <div class="space-y-8 text-[15px] leading-relaxed">
        <section>
          <h2 class="text-lg font-semibold text-fg mb-2">{t(lang as string, 'contactSupportChannels')}</h2>
          <p>{t(lang as string, 'contactSupportDesc')}</p>
          <p class="mt-3 text-base font-medium"><a href={`mailto:${siteConfig.contactEmail}`} class="text-accent hover:underline">{siteConfig.contactEmail}</a></p>
        </section>

        <section>
          <h2 class="text-lg font-semibold text-fg mb-2">{t(lang as string, 'contactCompliance')}</h2>
          <p>{t(lang as string, 'contactComplianceDesc').split('localStorage')[0]}<code class="px-1.5 py-0.5 rounded-md bg-surface-2 text-fg text-[13px]">localStorage</code>{t(lang as string, 'contactComplianceDesc').split('localStorage')[1]}</p>
          <p class="mt-4">{t(lang as string, 'contactOfficer')}</p>
        </section>
      </div>
    </div>
  </main>
</Layout>
