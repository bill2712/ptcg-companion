{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ptcg-companion",
  "compatibility_date": "2026-05-28",
  "assets": {
    "directory": "./dist",
    // Serve dist/404.html with a 404 status for unknown URLs. Without this
    // Cloudflare returns an empty 404 page.
    "not_found_handling": "404-page"
  }
}
